<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.batchlab.mapper.TransactionMapper">

    <resultMap id="BaseResultMap" type="com.example.batchlab.domain.entity.TransactionEntity">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="amount" property="amount" />
        <result column="status" property="status" />
    </resultMap>

    <insert id="insert" parameterType="com.example.batchlab.domain.entity.TransactionEntity">
        INSERT INTO transaction_info (id, name, amount, status)
        VALUES (#{id}, #{name}, #{amount}, #{status})
    </insert>

    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO transaction_info (id, name, amount, status)
        VALUES 
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.name}, #{item.amount}, #{item.status})
        </foreach>
    </insert>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT id, name, amount, status FROM transaction_info ORDER BY id ASC
    </select>

</mapper>
